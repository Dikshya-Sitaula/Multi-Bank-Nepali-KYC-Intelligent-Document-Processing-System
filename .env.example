# Copy to .env and edit. Never commit .env.
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./kyc_idp.db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MODELS_DIR=./models
TEMPLATES_DIR=./templates
CONFIG_DIR=./config
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=480
# UI development only. When true every screen shows a MOCK banner. Never use for demos.
MOCK_CV=false
LOG_OCR_TEXT=false
